# Local API and database ports published by Docker Compose.
SITETRACK_HTTP_PORT=8080
SITETRACK_DATABASE_PORT=5433

# Used by go run / Task commands on the host. Compose uses its internal hostname.
SITETRACK_DATABASE_URL=postgres://sitetrack:sitetrack@localhost:5433/sitetrack?sslmode=disable
SITETRACK_DATABASE_MAX_CONNECTIONS=10
