# API
SITETRACK_HTTP_PORT=8080

# Database
SITETRACK_DATABASE_PORT=5433
SITETRACK_DATABASE_URL=postgres://sitetrack:sitetrack@localhost:5433/sitetrack?sslmode=disable
SITETRACK_DATABASE_API_MAX_CONNECTIONS=15
SITETRACK_DATABASE_WORKER_MAX_CONNECTIONS=10
SITETRACK_DATABASE_MIGRATION_MAX_CONNECTIONS=1

# Rate limiting
SITETRACK_RATE_LIMIT_ENABLED=true

# Authentication
SITETRACK_OTP_SECRET=
SITETRACK_OUTBOX_ENCRYPTION_KEY=
SITETRACK_JWT_SIGNING_SECRET=

# Email
SITETRACK_EMAIL_FROM=SiteTrack <onboarding@resend.dev>
SITETRACK_RESEND_API_KEY=

# Telemetry
SITETRACK_TELEMETRY_ENABLED=false
SITETRACK_ENVIRONMENT=development
SITETRACK_OTLP_ENDPOINT=https://otlp.nr-data.net
SITETRACK_OTLP_API_KEY=
SITETRACK_TRACE_SAMPLE_RATIO=0.1
